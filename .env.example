# SupplyChain360 - Environment Variables Example Template
# Copy this file to .env and adjust variables as needed

# Flask Configuration
FLASK_ENV=development
PORT=5000
SECRET_KEY=dev-secret-key-supplychain360-super-secure

# Database
DATABASE_URL=sqlite:///instance/supplychain360.db
TEST_DATABASE_URL=sqlite:///:memory:

# Security & CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Application Defaults
DEMO_MODE=true
